// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Country {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  name     String
  flag     String @default("")
  region   String
  currency String

  // Income tax (JSON: brackets array + topRate + notes)
  incomeTaxTopRate Float   @default(0) @map("income_tax_top_rate")
  incomeTaxBrackets String? @map("income_tax_brackets") // JSON string of brackets array
  incomeTaxNotes   String? @map("income_tax_notes")

  // Corporate tax
  corporateTaxRate          Float   @default(0) @map("corporate_tax_rate")
  corporateTaxSmallBizRate  Float?  @map("corporate_tax_small_biz_rate")
  corporateTaxNotes         String? @map("corporate_tax_notes")

  // VAT
  vatStandardRate Float   @default(0) @map("vat_standard_rate")
  vatReducedRates String? @map("vat_reduced_rates") // JSON string of rates array
  vatNotes        String? @map("vat_notes")

  // Capital gains tax
  capitalGainsTaxRate     Float   @default(0) @map("capital_gains_tax_rate")
  capitalGainsTaxLongTerm Float?  @map("capital_gains_tax_long_term")
  capitalGainsTaxNotes    String? @map("capital_gains_tax_notes")

  // Social security
  socialSecurityEmployee     Float   @default(0) @map("social_security_employee")
  socialSecurityEmployer     Float   @default(0) @map("social_security_employer")
  socialSecuritySelfEmployed Float?  @map("social_security_self_employed")
  socialSecurityNotes        String? @map("social_security_notes")

  // Special regimes (JSON array of objects)
  specialRegimes String? @map("special_regimes")

  // Indexes and lifestyle
  taxTreaties        Int     @default(0) @map("tax_treaties")
  costOfLivingIndex  Float?  @map("cost_of_living_index")
  qualityOfLifeIndex Float?  @map("quality_of_life_index")

  // Digital nomad
  digitalNomadVisa        Boolean @default(false) @map("digital_nomad_visa")
  digitalNomadVisaDetails String? @map("digital_nomad_visa_details")

  // Summary & SEO content
  summary String?
  pros    String? // JSON array
  cons    String? // JSON array
  bestFor String? @map("best_for") // JSON array

  lastUpdated String? @map("last_updated")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  comparisonsA Comparison[] @relation("CountryA")
  comparisonsB Comparison[] @relation("CountryB")

  @@map("countries")
}

model Comparison {
  id        Int    @id @default(autoincrement())
  slug      String @unique
  countryAId Int   @map("country_a_id")
  countryBId Int   @map("country_b_id")

  countryA Country @relation("CountryA", fields: [countryAId], references: [id])
  countryB Country @relation("CountryB", fields: [countryBId], references: [id])

  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("comparisons")
}

model Guide {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  excerpt   String
  content   String   // Markdown content
  tags      String   // Comma-separated tags
  author    String   @default("WhereToPayLessTax Team")

  // SEO
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("guides")
}
